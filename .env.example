# Copier ce fichier vers .env (ignoré par git) et adapter les valeurs.
# Utilisé par .vscode/launch.json ("ipx2mqtt (avec .env)") et par docker compose.

# --- Broker MQTT ---
Mqtt__Host=localhost
Mqtt__Port=1883
#Mqtt__Username=
#Mqtt__Password=

# --- IPX800 V5 ---
Ipx__BaseUrl=http://192.168.1.54
Ipx__Login=api
Ipx__Password=change-me
#Ipx__ApiKey=

# --- Home Assistant ---
Device__NodeId=ipx800
